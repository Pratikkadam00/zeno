{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB,en",
  "ignorePaths": [
    "**/*.test.*",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/.next/**",
    "**/public/art/**",
    "**/public/og/**"
  ],
  "words": [
    "ARPU",
    "CCPA",
    "Catmull",
    "Conv",
    "Groq",
    "Grotesk",
    "Hanken",
    "Turbopack",
    "WAAPI",
    "YNAB",
    "crosslinks",
    "dvar",
    "hrefs",
    "jank",
    "leafable",
    "lede",
    "llms",
    "nosemgrep",
    "ondismiss",
    "paise",
    "penu",
    "prerendered",
    "scrollers",
    "signups",
    "strapline",
    "tweened",
    "tweens",
    "uncoverable",
    "unparseable",
    "unstub",
    "vflash",
    "waitlist",
    "wordmark",
    "zenoapp"
  ],
  "ignoreRegExpList": [
    "/\\w*&(rsquo|lsquo|apos|#39|#x27);\\w*/g",
    "/&[a-z]+;/g",
    "/&#x?[0-9a-f]+;/gi"
  ]
}
