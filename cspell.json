{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB,en",
  "ignorePaths": ["**/*.test.*", "**/*.spec.ts", "**/node_modules/**", "**/.next/**", "**/public/art/**", "**/public/og/**"],
  "words": [
    "ARPU",
    "Catmull",
    "CCPA",
    "Conv",
    "crosslinks",
    "dvar",
    "Groq",
    "Grotesk",
    "Hanken",
    "hrefs",
    "jank",
    "leafable",
    "lede",
    "llms",
    "penu",
    "scrollers",
    "signups",
    "Turbopack",
    "tweened",
    "tweens",
    "uncoverable",
    "unparseable",
    "unstub",
    "vflash",
    "WAAPI",
    "waitlist",
    "YNAB",
    "zenoapp"
  ],
  "ignoreRegExpList": ["/\\w*&(rsquo|lsquo|apos|#39|#x27);\\w*/g", "/&[a-z]+;/g", "/&#x?[0-9a-f]+;/gi"]
}
