{
  "name": "zeno",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Zeno subscription intelligence monorepo.",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @zeno/mobile run start",
    "dev:api": "npm --workspace @zeno/api run dev",
    "dev:web": "npm --workspace @zeno/web run dev",
    "build": "npm run typecheck && npm --workspace @zeno/web run build",
    "typecheck": "npm run typecheck:refs && npm --workspace @zeno/mobile run typecheck && npm --workspace @zeno/web run typecheck",
    "typecheck:refs": "tsc -b --force --pretty false",
    "lint": "eslint . && npm --workspace @zeno/web run lint && npm --workspace @zeno/mobile run lint",
    "test": "vitest run",
    "test:rn": "npm --workspace @zeno/mobile run test:rn",
    "test:rn:coverage": "npm --workspace @zeno/mobile run test:rn:coverage",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:web:coverage": "vitest run -c vitest.web.config.ts --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "jsdom": "^20.0.3",
    "sharp": "^0.35.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.15"
  }
}
